RELAY_DOMAIN=alphachannel.duckdns.org
ADMIN_TOKEN=change-me-to-a-random-secret
POSTGRES_USER=alphachannel
POSTGRES_PASSWORD=change-me-to-a-random-secret
POSTGRES_DB=alphachannel

# From registering AlphaChannel as its own OAuth app at https://xivauth.net/developer/docs (a
# separate registration from any other project's) - client_id/secret from that registration. The
# endpoint URLs below are confirmed against XIVAuth's "Authenticating to the API" docs and
# shouldn't need changing unless XIVAuth's API surface changes (it's explicitly marked WIP).
XIVAUTH_CLIENT_ID=
XIVAUTH_CLIENT_SECRET=
XIVAUTH_DEVICE_ENDPOINT=https://xivauth.net/oauth/authorize_device
XIVAUTH_TOKEN_ENDPOINT=https://xivauth.net/oauth/token
XIVAUTH_CHARACTERS_ENDPOINT=https://xivauth.net/api/v1/characters

# Optional - a Discord incoming webhook URL for the channel where the team reviews pending
# Lalafell social-access requests (see /admin/ui for the actual approve/deny action). Leave blank
# to skip Discord notifications entirely.
DISCORD_LALAFELL_WEBHOOK_URL=

# "Go Live" self-hosted streaming (see mediamtx.yml + the mediamtx service in docker-compose.yml).
# MEDIAMTX_WEBHOOK_SECRET is a random shared secret only MediaMTX and this server know - generate
# one the same way ADMIN_TOKEN was generated (it's never a per-account credential, just proves a
# request to /live/media/* actually came from our own MediaMTX container).
# CDN_HOSTNAME is the pull-zone hostname from your CDN provider (e.g. Bunny.net) once it's set up
# to pull HLS segments from this VM's port 8888 - see the plan doc for the exact setup steps. Until
# this is set, HlsUrl values fall back to RELAY_DOMAIN, which works for testing but won't scale.
MEDIAMTX_WEBHOOK_SECRET=change-me-to-a-random-secret
CDN_HOSTNAME=

# Optional - enables the Twitch trending/discovery feed (Player > Twitch tab). Register an app at
# https://dev.twitch.tv/console/apps to get these; leave blank to skip the trending feed (the
# existing single-channel Twitch live-check still works either way).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Icecast (Music/DJ ingest, docker-compose icecast service, port 8000). Mixxx/BUTT use the source
# password; isolation between accounts is the /radio/{accountId} mount issued by POST /radio/me.
ICECAST_SOURCE_PASSWORD=change-me-to-a-random-secret
ICECAST_ADMIN_PASSWORD=change-me-to-a-random-secret
ICECAST_RELAY_PASSWORD=change-me-to-a-random-secret
